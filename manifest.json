{
  "manifest_version": 3,
  "name": "Review Booster",
  "version": "1.0.0",
  "description": "AI-powered Google Maps review generator",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://*.google.com/maps/*",
    "https://*.google.*/maps/*",
    "https://api.ipify.org/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps/*",
        "https://*.google.*/maps/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
